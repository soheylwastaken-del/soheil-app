{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soheil-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4d565969-9099-44fc-92ea-53e338a9abb4","database_name": "Soheil-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "97284db9c4a449c888a831e3bc762f58" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
